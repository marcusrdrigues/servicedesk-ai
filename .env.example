# Copie para .env (que está no .gitignore) e preencha. Todos os valores abaixo são fictícios.
# Nunca versione valores reais.

# Provedor principal (OpenAI)
OPENAI_API_KEY=troque-por-sua-chave
OPENAI_CHAT_MODEL=troque-pelo-id-do-modelo-com-versao

# Provedor de reserva (Gemini, endpoint compatível com OpenAI)
GEMINI_API_KEY=troque-por-sua-chave
GEMINI_CHAT_MODEL=troque-pelo-id-do-modelo-com-versao

# Segredo da API (cabeçalho X-API-Key). Gere um valor longo e aleatório.
SERVICEDESK_API_KEY=troque-por-um-segredo-longo

# E-mail. EMAIL_TO vem do servidor: nem o modelo nem a requisição escolhem o destinatário.
EMAIL_MODE=smtp
EMAIL_TO=suporte@exemplo.local
EMAIL_FROM=servicedesk@exemplo.local
SMTP_HOST=localhost
SMTP_PORT=1025

# RabbitMQ. Use senha só com letras e números: ela entra na URL abaixo sem codificação.
RABBITMQ_USER=servicedesk
RABBITMQ_PASSWORD=troque-por-uma-senha
# Rodando a aplicação fora do Docker (mvnw spring-boot:run):
RABBITMQ_URL=amqp://servicedesk:troque-por-uma-senha@localhost:5672

# Só na nuvem (EMAIL_MODE=resend)
# RESEND_API_KEY=troque-por-sua-chave
# SERVICEDESK_CORS_ORIGEM=https://seu-portal.vercel.app
